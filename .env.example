# Copy to .env and fill in. Never commit .env — it holds a live credential.

APP_ENV=dev
PORT=8080

# Neon connection string. The ?sslmode=require suffix is mandatory: Neon
# refuses unencrypted connections, and config.Load fails at startup without it
# rather than letting you discover it at the first query.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Must stay under 10s — Cloud Run SIGKILLs that long after SIGTERM.
SHUTDOWN_GRACE=8s
HEALTH_TIMEOUT=2s

# Auth0. Leave both blank in dev to use the header-based dev authenticator;
# set them and the same binary switches to real JWT verification with no other
# change. Outside dev they are mandatory — config.Load refuses to start without
# them, because the fallback trusts an unverified header.
#
# AUTH0_DOMAIN is the bare tenant host, no scheme.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
